std::vector<s32> TeamLampFlagsToSet(const WorldFlags& target, const std::function<bool(s32)>& on) {
    return std::binary_search(target.on.begin(), target.on.end(), 9) && !on(9)
        ? std::vector<s32>{9} : std::vector<s32>{};
}
std::vector<s32> TeamWorldLamps(u32, std::span<const u32>, const WorldFlags&) { return {}; }
void ListLamps(const std::vector<s32>&) {}
