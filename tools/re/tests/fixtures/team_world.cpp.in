std::atomic<bool> kept_lamps_reset{false};
std::mutex relit_lamps_mutex;
std::set<s32> relit_lamps;
bool IsPartyGuestRole() { return !team_host; }
bool InPartySession() { return true; }
std::vector<s32> LitHeadstoneLamps(const std::function<bool(s32)>& on) {
    std::vector<s32> lamps;
    for (s32 flag : {8, 9}) if (on(flag)) lamps.push_back(flag);
    return lamps;
}
std::optional<s32> LampOfActiveFlag(s32 flag) { return flag == 8 || flag == 9 ? std::optional{flag} : std::nullopt; }
std::vector<s32> LampsToRelight(const std::set<s32>& kept, std::span<const s32> team,
                             const std::function<bool(s32)>& on) {
    std::set<s32> flags = kept;
    flags.insert(team.begin(), team.end());
    std::vector<s32> result;
    for (s32 flag : flags) if (LampOfActiveFlag(flag) && !on(flag)) result.push_back(flag);
    return result;
}
// PRODUCTION_LAMPS

void Reset(bool host = false, bool exists = false) {
    for (const auto& entry : std::filesystem::directory_iterator(test_root)) std::filesystem::remove_all(entry.path());
    memory = {{1, {0x80}}}; // Own flag 8 on, host lamp 9 off.
    team_host = host; team_world_taken = false; personal_world_due = false;
    team_world_due = true; team_take.reset(); team_world_blocks.clear(); character_slot = 0;
    kept_lamps_reset = true; relit_lamps.clear();
    team_world = bbcoop::TeamWorld{exists, {{9}, {1}}};
}
bool GuestEnteringANewWorldKeepsOwnProgressBeforeTheHostReports() {
    Reset();
    ApplyTeamWorldOnLoad(false);
    const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(own && own->on == std::vector<s32>{8});
    CHECK(ReadHomeWorlds(0).has_value());
    SetGameFlag(0, 8, false); SetGameFlag(0, 9, true); // What the guest later saved in the visit.
    team_world_due = false; personal_world_due = true;
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool ExistingWorldLampsNeverPolluteTheOwnBackup() {
    Reset(false, true);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(9)); CHECK(!EventFlagOn(8));
    const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(own && own->on == std::vector<s32>{8});
    return true;
}
bool BecomingANewHostRestoresOwnBlocksBeforeRegisteringHome() {
    Reset(true);
    WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({}));
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8, 16}, {1, 2}}));
    memory[1][0] = 0x40; // Previously visited host's flags in the save.
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9));
    CHECK(ReadHomeWorlds(0)->Has("test"));
    auto remaining = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(remaining && remaining->blocks == std::vector<u32>{2});
    memory[2] = {0}; team_world_blocks.clear();
    ApplyTeamWorldOnLoad(true);
    CHECK(EventFlagOn(16));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool ARepeatLoadKeepsTheOriginalBackup() {
    Reset(false, true);
    ApplyTeamWorldOnLoad(false);
    const auto original = ReadWholeFile(PersonalWorldFile(0));
    ApplyTeamWorldOnLoad(true);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == original);
    return true;
}
bool OwnFlagsFollowTheSlotAndDisappearWithTheBackup() {
    Reset();
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    WriteWholeFile(PersonalWorldFile(1), FormatWorldFlags({{16}, {2}}));
    CHECK(OwnWorldAsideFlagsOn() == std::vector<s32>{8});
    character_slot = 1;
    CHECK(OwnWorldAsideFlagsOn() == std::vector<s32>{16});
    std::filesystem::remove(PersonalWorldFile(1));
    CHECK(OwnWorldAsideFlagsOn().empty());
    return true;
}
bool TitleJoinRelightsOwnAndTeamLampsFromTheirSeparateSources() {
    Reset(false, true);
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    memory[1][0] = 0; // No prior solo tick; the guest started at the title.
    KeepGuestLampsLit();
    CHECK(EventFlagOn(8)); CHECK(EventFlagOn(9));
    CHECK(relit_lamps == (std::set<s32>{8, 9}));
    CHECK(ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)))->on == std::vector<s32>{8});
    return true;
}
bool FailedBackupDefersExistingWorldAndCanRetry() {
    Reset(false, true);
    auto partial = PersonalWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    std::ofstream{partial / "blocker"} << "fixture";
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(!EventFlagOn(8)); CHECK(EventFlagOn(9)); CHECK(team_world_taken);
    CHECK(ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)))->on == std::vector<s32>{8});
    return true;
}
bool FailedBackupDefersAnUncreatedWorld() {
    Reset();
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool MalformedOrUnreadableBackupNeverBecomesAnEmptyOwnWorld() {
    for (bool directory : {false, true}) {
        Reset(false, true);
        if (directory) std::filesystem::create_directory(PersonalWorldFile(0));
        else std::ofstream{PersonalWorldFile(0)} << "broken-backup";
        ApplyTeamWorldOnLoad(false);
        CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
        if (!directory) CHECK(ReadWholeFile(PersonalWorldFile(0)) == "broken-backup");
    }
    return true;
}
bool FailedBackupExtensionPreservesThePreviousCompleteBackup() {
    Reset(false, true);
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    const std::string before = ReadWholeFile(PersonalWorldFile(0));
    memory[2] = {0x80}; team_world->flags = {{9, 17}, {1, 2}};
    auto partial = PersonalWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(EventFlagOn(16));
    CHECK(!EventFlagOn(9)); CHECK(!EventFlagOn(17)); CHECK(!team_world_taken);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    return true;
}
bool FailedNativeRestoreKeepsBackupAndBlocksHomeRegistration() {
    Reset(true);
    WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({}));
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    const auto before = ReadWholeFile(PersonalWorldFile(0));
    memory[1][0] = 0x40;
    ignored_flag = 8;
    ApplyTeamWorldOnLoad(false);
    ignored_flag = -1;
    CHECK(!EventFlagOn(8) && personal_world_due && !team_world_taken);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    CHECK(ReadHomeWorlds(0)->worlds.empty());
    CHECK(PutOwnWorldBack(0, "fixture retry"));
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}


bool RetireOwnWorldPreservesOldArchivesAndLiveSnapshot() {
    Reset();
    const auto live = PersonalWorldFile(0);
    const auto old = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "live-private-world"; }
    { std::ofstream file{old}; file << "older-private-world"; }
    CHECK(RetireOwnWorld(0));
    CHECK(!std::filesystem::exists(live));
    CHECK(ReadWholeFile(old) == "older-private-world");
    CHECK(ReadWholeFile(old.string() + ".1") == "live-private-world");
    return true;
}
bool RetireOwnWorldArchiveExhaustionNeverDeletesBackup() {
    Reset();
    const auto live = PersonalWorldFile(0);
    const auto old = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "must-not-be-deleted"; }
    for (int i = 0; i < 64; ++i) {
        const auto name = i == 0 ? old : std::filesystem::path(old.string() + "." + std::to_string(i));
        { std::ofstream file{name}; file << "previous-archive"; }
    }
    CHECK(!RetireOwnWorld(0));
    CHECK(ReadWholeFile(live) == "must-not-be-deleted");
    CHECK(ReadWholeFile(old) == "previous-archive");
    CHECK(ReadWholeFile(old.string() + ".63") == "previous-archive");
    return true;
}

// A legacy host must keep its only personal-world sidecar when the home
// metadata destination is unwritable (simulated by a directory at the path).
// Once the filesystem recovers, the next load must retry the registration.
bool FailedLegacyHomeWriteKeepsPersonalSnapshotAndRetries() {
    Reset(true, true);
    const auto old_name = lobby_name;
    lobby_name = "host";
    const auto live = PersonalWorldFile(0);
    const auto archived = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "legacy-private-world"; }
    std::filesystem::create_directory(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(ReadWholeFile(live) == "legacy-private-world");
    CHECK(!std::filesystem::exists(archived));
    CHECK(!team_take.has_value());
    std::filesystem::remove_all(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Has("test"));
    CHECK(!std::filesystem::exists(live));
    CHECK(ReadWholeFile(archived) == "legacy-private-world");
    lobby_name = old_name;
    return true;
}

// A new host must not mark the team's first world taken if home metadata
// could not be committed. Retry after repairing the target path.
bool FailedNewHostHomeWriteDoesNotClaimRegisteredWorld() {
    Reset(true, false);
    std::filesystem::create_directory(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_world_taken);
    std::filesystem::remove_all(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Has("test"));
    return true;
}


// Failure-injected metadata writes must not permit a guest's last solo backup
// to be consumed while the durable home-world marker still says "in team".
bool FailedAloneMarkerWriteKeepsOwnWorldForRetry() {
    Reset(false, false);
    HomeWorlds home;
    CHECK(home.Add("test"));
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    CHECK(WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}})));
    memory[1][0] = 0x40; // Team visit took flag 8 away and lit 9.
    personal_world_due = true;
    team_world_due = false;
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(personal_world_due);
    CHECK(!EventFlagOn(8) && EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->alone);
    CHECK(std::filesystem::exists(PersonalWorldFile(0)));
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->alone);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}

// An unsuccessful "back in team" marker write must leave both the in-memory
// take decision and original flag state pending. Re-read original alone=true
// on retry, so SaveLeads vs Home is decided from the right save provenance.
bool FailedRejoinMarkerWriteDefersTeamFlagsAndDecision() {
    Reset(false, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    home.alone = true;
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_take.has_value());
    CHECK(!team_world_taken);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->alone);
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(team_take.has_value() && team_world_taken);
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->alone);
    CHECK(!EventFlagOn(8) && EventFlagOn(9));
    return true;
}

// A next-playthrough transition cannot mark its old backup retired when the
// filesystem refuses to remove it. The flag and sidecar remain for retry.
bool FailedNextPlaythroughSidecarRemovalKeepsPendingTransition() {
    Reset(true, false);
    const auto own = PersonalWorldFile(0);
    std::filesystem::create_directory(own);
    { std::ofstream file{own / "cannot-delete"}; file << "keep old state"; }
    next_playthrough_due = true;
    personal_world_due = true;
    ApplyTeamWorldOnLoad(false);
    CHECK(next_playthrough_due && personal_world_due && !team_world_taken);
    CHECK(std::filesystem::exists(own / "cannot-delete"));
    std::filesystem::remove_all(own);
    CHECK(WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
    ApplyTeamWorldOnLoad(false);
    CHECK(!next_playthrough_due && !personal_world_due);
    CHECK(!std::filesystem::exists(own));
    return true;
}


// The world version must retry after a failed sidecar write rather than
// advancing a cache in memory; two characters with the same world/version
// must each receive the metadata in their *own* slot.
bool HostVersionNoteRetriesAndNeverCrossesCharacterSlots() {
    Reset(true, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    CHECK(WriteWholeFile(HomeWorldFile(1), FormatHomeWorlds(home)));
    NoteHomeWorldVersionIfChanged(0, "test", 11);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 0);
    NoteHomeWorldVersionIfChanged(1, "test", 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    // A version change on the original slot must not be acknowledged when
    // a blocked .part path prevents the atomic replacement.
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    NoteHomeWorldVersionIfChanged(0, "test", 12);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    std::filesystem::remove_all(partial);
    NoteHomeWorldVersionIfChanged(0, "test", 12);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 12);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    return true;
}


// A void-returning native flag setter may silently reject one of the team's
// changes while a level is loading. Keep both the personal snapshot and the
// uncommitted team-world blocks available for a later successful retry.
bool RejectedNativeTeamFlagWriteDoesNotAcknowledgeWorldTakeover() {
    Reset(false, true);
    ignored_flag = 9; // Native setter refuses the team's lamp/quest flag.
    ApplyTeamWorldOnLoad(false);
    ignored_flag = -1;
    CHECK(!team_world_taken);
    CHECK(team_world_blocks.empty());
    CHECK(!EventFlagOn(9));
    const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(own && own->on == std::vector<s32>{8});
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken);
    CHECK(team_world_blocks.contains(1));
    CHECK(EventFlagOn(9) && !EventFlagOn(8));
    const auto after = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(after && after->on == std::vector<s32>{8});
    return true;
}


// An oversized or corrupted personal sidecar is not an empty solo world.
// Refuse to allocate unbounded memory or apply team flags while the only
// original snapshot has not been recovered by the player.
bool OversizedOwnWorldNeverLoadsOrGetsOverwritten() {
    Reset(false, true);
    const auto own = PersonalWorldFile(0);
    { std::ofstream file{own, std::ios::binary}; file << 'x'; }
    std::filesystem::resize_file(own, MaxWorldSidecarBytes + 1);
    CHECK(ReadWholeFile(own).empty());
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_world_taken);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(std::filesystem::file_size(own) == MaxWorldSidecarBytes + 1);
    // Only an explicit test recovery may replace the damaged original.
    std::filesystem::remove(own);
    CHECK(WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken && !EventFlagOn(8) && EventFlagOn(9));
    CHECK(ParseWorldFlags(ReadWholeFile(own))->on == std::vector<s32>{8});
    return true;
}


// A malformed/oversized existing home-world record is not the same as one
// that never existed: both host creation and guest visits must not overwrite
// it, consume a personal backup, or apply the borrowed world prematurely.
bool DamagedHomeMetadataIsNotReplacedOnHostOrGuestJoin() {
    for (bool host : {true, false}) {
        Reset(host, !host);
        const auto home = HomeWorldFile(0);
        { std::ofstream file{home}; file << "broken home record"; }
        const auto before = ReadWholeFile(home);
        ApplyTeamWorldOnLoad(false);
        CHECK(!team_world_taken);
        CHECK(EventFlagOn(8) && !EventFlagOn(9));
        CHECK(ReadWholeFile(home) == before);
        CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
        std::filesystem::remove(home);
        ApplyTeamWorldOnLoad(false);
        CHECK(team_world_taken);
        CHECK(ReadHomeWorlds(0).has_value());
        if (!host) {
            CHECK(!EventFlagOn(8) && EventFlagOn(9));
            const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
            CHECK(own && own->on == std::vector<s32>{8});
        }
    }
    return true;
}

// Solo restoration must keep a valid personal backup untouched if the home
// marker is corrupt. Once explicitly repaired/removed, restore solo flags.
bool DamagedHomeMetadataDefersPersonalRestoreWithoutLosingBackup() {
    Reset(false, false);
    const auto home = HomeWorldFile(0);
    const auto own = PersonalWorldFile(0);
    { std::ofstream file{home}; file << "damaged"; }
    CHECK(WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
    memory[1][0] = 0x40;
    personal_world_due = true;
    team_world_due = false;
    ApplyTeamWorldOnLoad(false);
    CHECK(personal_world_due);
    CHECK(!EventFlagOn(8) && EventFlagOn(9));
    CHECK(std::filesystem::exists(own) && ReadWholeFile(home) == "damaged");
    std::filesystem::remove(home);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(!std::filesystem::exists(own));
    return true;
}


// A redirected source or staging name must not consume another character's
// data. Windows runners may lack the privilege to create a test symlink, so
// this fixture also exercises a .part directory on all platforms.
bool LinkedSidecarsAndScratchFilesNeverTruncateOutsideWorldData() {
    Reset(false, true);
    const auto outside = test_root / "unrelated-character-data";
    { std::ofstream file{outside}; file << "never-touch-this"; }
    auto partial = HomeWorldFile(0);
    partial += ".part";
    std::error_code error;
    std::filesystem::create_symlink(outside, partial, error);
    if (!error) {
        CHECK(!WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({})));
        CHECK(ReadWholeFile(outside) == "never-touch-this");
        std::filesystem::remove(partial);
    } else {
        error.clear();
        std::filesystem::create_directory(partial);
        CHECK(!WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({})));
        CHECK(ReadWholeFile(outside) == "never-touch-this");
        std::filesystem::remove(partial);
    }

    const auto home = HomeWorldFile(0);
    std::filesystem::create_symlink(outside, home, error);
    if (!error) {
        CHECK(ReadWholeFile(home).empty());
        CHECK(!WriteWholeFile(home, FormatHomeWorlds({})));
        ApplyTeamWorldOnLoad(false);
        CHECK(!team_world_taken && EventFlagOn(8) && !EventFlagOn(9));
        CHECK(ReadWholeFile(outside) == "never-touch-this");
        std::filesystem::remove(home);
    }
    error.clear();
    const auto own = PersonalWorldFile(0);
    std::filesystem::create_symlink(outside, own, error);
    if (!error) {
        CHECK(ReadWholeFile(own).empty());
        CHECK(!WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
        RetireOwnWorld(0);
        CHECK(std::filesystem::is_symlink(own));
        CHECK(ReadWholeFile(outside) == "never-touch-this");
        std::filesystem::remove(own);
    }
    return true;
}


// A verified native restore is not fully complete until the remaining
// personal-world sidecar is persisted. A failed .part write must NOT let a
// former guest's snapshot be registered as this new host's home world.
bool FailedPartialPersonalRestoreDoesNotRegisterNewHostWorld() {
    Reset(true, false);
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({})));
    CHECK(WriteWholeFile(PersonalWorldFile(0),
                         FormatWorldFlags({{8, 16}, {1, 2}})));
    const auto before = ReadWholeFile(PersonalWorldFile(0));
    memory[1][0] = 0x40; // A visited host's flag 9, not the solo flag 8.
    auto partial = PersonalWorldFile(0);
    partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8) && !EventFlagOn(9)); // native restore did work
    CHECK(!team_world_taken);
    CHECK(personal_world_due);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->worlds.empty());
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    // The server can be late: a pending team transfer must not be mistaken
    // for leaving the team just because its world has not arrived yet.
    team_world.reset();
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_world_taken && personal_world_due);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->worlds.empty());
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    team_world = bbcoop::TeamWorld{false, {{9}, {1}}};
    std::filesystem::remove(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken && !personal_world_due);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Has("test"));
    const auto remaining = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(remaining && remaining->blocks == std::vector<u32>{2});
    return true;
}


// NG+ must not bypass the home provenance validation introduced for regular
// host/guest/solo loads and discard the last prior playthrough backup. After
// explicit repair, the queued NG+ transition should retire the old snapshot.
bool NgPlusKeepsLastPersonalSnapshotUntilHomeProvenanceRecovers() {
    Reset(true, false);
    const auto home = HomeWorldFile(0);
    const auto own = PersonalWorldFile(0);
    { std::ofstream file{home}; file << "unreadable home state"; }
    CHECK(WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
    const auto original = ReadWholeFile(own);
    next_playthrough_due = true;
    personal_world_due = true;
    ApplyTeamWorldOnLoad(false);
    CHECK(next_playthrough_due && personal_world_due);
    CHECK(ReadWholeFile(own) == original);
    CHECK(ReadWholeFile(home) == "unreadable home state");
    // The player restores home provenance explicitly; only now may NG+ drop
    // the old snapshot and advance to the new playthrough.
    std::filesystem::remove(home);
    ApplyTeamWorldOnLoad(false);
    CHECK(!next_playthrough_due && !personal_world_due);
    CHECK(!std::filesystem::exists(own));
    return true;
}


// Home registration is not committed until a legacy personal snapshot is
// archived. When all archive slots are occupied the pending marker persists,
// no team world is taken, and an explicit released slot allows safe retry.
bool LegacyHostArchiveExhaustionPersistsIntentAndRetries() {
    Reset(true, true);
    const auto old_name = lobby_name;
    lobby_name = "host";
    const auto live = PersonalWorldFile(0);
    const auto archive = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "legacy-live-personal"; }
    for (int n = 0; n < 64; ++n) {
        const auto target = n == 0 ? archive :
            std::filesystem::path(archive.string() + "." + std::to_string(n));
        { std::ofstream file{target}; file << "older-" << n; }
    }
    ApplyTeamWorldOnLoad(false);
    const auto pending = ReadHomeWorlds(0);
    CHECK(pending && pending->Has("test") && pending->archive_pending);
    CHECK(!team_take.has_value() && !team_world_taken);
    CHECK(ReadWholeFile(live) == "legacy-live-personal");
    CHECK(ReadWholeFile(archive) == "older-0");
    // This is an operator/user recovery action, not silent deletion of old
    // archives. Retry after freeing *only* the last test slot.
    const auto released = std::filesystem::path(archive.string() + ".63");
    std::filesystem::remove(released);
    ApplyTeamWorldOnLoad(false);
    const auto committed = ReadHomeWorlds(0);
    CHECK(committed && committed->Has("test") && !committed->archive_pending);
    CHECK(team_world_taken && team_take.has_value());
    CHECK(!std::filesystem::exists(live));
    CHECK(ReadWholeFile(released) == "legacy-live-personal");
    CHECK(ReadWholeFile(archive) == "older-0");
    lobby_name = old_name;
    return true;
}

// If the process ended after the sidecar rename but before the pending home
// marker was cleared, recovery is idempotent: the renamed backup is not
// overwritten or archived again, and registration completes.
bool ArchivedBeforeMarkerClearResumesAfterRestart() {
    Reset(true, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    home.archive_pending = true;
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    CHECK(ParseHomeWorlds(FormatHomeWorlds(home))->archive_pending);
    CHECK(!ParseHomeWorlds("worlds\ntest 0\narchive_pending\narchive_pending\nend\n"));
    const auto live = PersonalWorldFile(0);
    const auto archive = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "saved-after-crash"; }
    CHECK(RetireOwnWorld(0)); // crash before home archive_pending=false write
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->archive_pending);
    ApplyTeamWorldOnLoad(false);
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->archive_pending);
    CHECK(team_world_taken && !std::filesystem::exists(live));
    CHECK(ReadWholeFile(archive) == "saved-after-crash");
    CHECK(!std::filesystem::exists(archive.string() + ".1"));
    return true;
}

// Failure writing the completion marker AFTER a successful archive rename
// leaves a recoverable persistent pending record. A later load retries marker
// publication without losing or replacing the already archived bytes.
bool FailedArchiveCompletionMarkerKeepsRetrying() {
    Reset(true, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    home.archive_pending = true;
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    const auto archive = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{PersonalWorldFile(0)}; file << "durable-old-world"; }
    auto partial = HomeWorldFile(0);
    partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_take.has_value() && !team_world_taken);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->archive_pending);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    CHECK(ReadWholeFile(archive) == "durable-old-world");
    std::filesystem::remove(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken && team_take.has_value());
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->archive_pending);
    CHECK(ReadWholeFile(archive) == "durable-old-world");
    return true;
}

// A 64-bit integer that fits from_chars may overflow the serialized
// 32-bit flag/block domain. Never let corrupt sidecar values wrap to an
// unrelated progression flag. Preserve the boundary values of valid saves.
bool WorldFlagsParserRejectsNarrowingAndKeepsValidBoundaries() {
    CHECK(!ParseWorldFlags("blocks\n4294967296\non\n8\nend\n"));
    CHECK(!ParseWorldFlags("blocks\n-1\non\n8\nend\n"));
    CHECK(!ParseWorldFlags("blocks\n1\non\n2147483648\nend\n"));
    CHECK(!ParseWorldFlags("blocks\n1\non\n-2147483649\nend\n"));
    CHECK(!ParseWorldFlags("blocks\n18446744073709551616\non\n8\nend\n"));
    CHECK(!ParseWorldFlags("blocks\n1\non\n9223372036854775807\nend\n"));
    const auto valid = ParseWorldFlags(
        "blocks\n0\n4294967295\non\n-2147483648\n0\n2147483647\nend\n");
    CHECK(valid.has_value());
    CHECK(valid->blocks == (std::vector<u32>{0, 4294967295u}));
    CHECK(valid->on == (std::vector<s32>{INT32_MIN, 0, INT32_MAX}));
    return true;
}

int main() {
    test_root = std::filesystem::temp_directory_path() /
        ("ultimate-world-fixture-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
    std::filesystem::create_directories(test_root);
    unsigned failed = 0;
    for (auto test : {GuestEnteringANewWorldKeepsOwnProgressBeforeTheHostReports,
                      ExistingWorldLampsNeverPolluteTheOwnBackup,
                      BecomingANewHostRestoresOwnBlocksBeforeRegisteringHome,
                      ARepeatLoadKeepsTheOriginalBackup,
                      OwnFlagsFollowTheSlotAndDisappearWithTheBackup,
                      TitleJoinRelightsOwnAndTeamLampsFromTheirSeparateSources,
                      FailedBackupDefersExistingWorldAndCanRetry,
                      FailedBackupDefersAnUncreatedWorld,
                      MalformedOrUnreadableBackupNeverBecomesAnEmptyOwnWorld,
                      FailedBackupExtensionPreservesThePreviousCompleteBackup,
                      FailedNativeRestoreKeepsBackupAndBlocksHomeRegistration,
                      RetireOwnWorldPreservesOldArchivesAndLiveSnapshot,
                      RetireOwnWorldArchiveExhaustionNeverDeletesBackup,
                      FailedLegacyHomeWriteKeepsPersonalSnapshotAndRetries,
                      FailedNewHostHomeWriteDoesNotClaimRegisteredWorld,
                      FailedAloneMarkerWriteKeepsOwnWorldForRetry,
                      FailedRejoinMarkerWriteDefersTeamFlagsAndDecision,
                      FailedNextPlaythroughSidecarRemovalKeepsPendingTransition,
                      HostVersionNoteRetriesAndNeverCrossesCharacterSlots,
                      RejectedNativeTeamFlagWriteDoesNotAcknowledgeWorldTakeover,
                      OversizedOwnWorldNeverLoadsOrGetsOverwritten,
                      DamagedHomeMetadataIsNotReplacedOnHostOrGuestJoin,
                      DamagedHomeMetadataDefersPersonalRestoreWithoutLosingBackup,
                      LinkedSidecarsAndScratchFilesNeverTruncateOutsideWorldData,
                      FailedPartialPersonalRestoreDoesNotRegisterNewHostWorld,
                      NgPlusKeepsLastPersonalSnapshotUntilHomeProvenanceRecovers,
                      LegacyHostArchiveExhaustionPersistsIntentAndRetries,
                      ArchivedBeforeMarkerClearResumesAfterRestart,
                      FailedArchiveCompletionMarkerKeepsRetrying,
                      WorldFlagsParserRejectsNarrowingAndKeepsValidBoundaries}) if (!test()) ++failed;
    std::filesystem::remove_all(test_root);
    std::cout << "World preservation scenarios: " << (30 - failed) << "/30 passed\n";
    return failed ? 1 : 0;
}
