std::string SlotFileName(std::string_view name, int slot) { return std::string(name) + std::to_string(slot); }
std::map<u32, std::array<u8, 1>> memory;
struct FlagStore {
    bool whole = true;
    u32 flags_per_block = 8;
    struct Block { u32 id; std::span<const u8> bytes; };
    std::vector<Block> blocks;
};
using FlagBlock = FlagStore::Block;
FlagStore ReadFlagStore() {
    FlagStore store;
    for (auto& [id, bytes] : memory) store.blocks.push_back({id, bytes});
    return store;
}
bool EventFlagOn(s32 flag) { return (memory[u32(flag) / 8][0] & (0x80 >> (u32(flag) % 8))) != 0; }
s32 ignored_flag = -1;
void SetGameFlag(u64, s32 flag, bool on) {
    if (flag == ignored_flag) return;
    auto& byte = memory[u32(flag) / 8][0];
    const u8 mask = static_cast<u8>(0x80 >> (u32(flag) % 8));
    byte = on ? static_cast<u8>(byte | mask) : static_cast<u8>(byte & ~mask);
}
u64 image_base = reinterpret_cast<u64>(&SetGameFlag);
constexpr u64 PartyGhostSetEventFlagOffset = 0, GameDataManPointerOffset = 0;
template<class T> T ReadValue(u64, u64) { return T{}; }
template<class T> std::optional<T> TryRead(u64, u64) { return std::nullopt; }
