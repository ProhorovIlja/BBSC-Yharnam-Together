std::atomic<bool> kept_lamps_reset{false};
std::mutex relit_lamps_mutex;
std::set<s32> relit_lamps;
bool IsPartyGuestRole() { return !team_host; }
bool InPartySession() { return true; }
std::vector<s32> LitHeadstoneLamps(const std::function<bool(s32)>& on) {
    std::vector<s32> lamps;
    for (s32 flag : {8, 9}) if (on(flag)) lamps.push_back(flag);
    return lamps;
}
std::optional<s32> LampOfActiveFlag(s32 flag) { return flag == 8 || flag == 9 ? std::optional{flag} : std::nullopt; }
std::vector<s32> LampsToRelight(const std::set<s32>& kept, std::span<const s32> team,
                             const std::function<bool(s32)>& on) {
    std::set<s32> flags = kept;
    flags.insert(team.begin(), team.end());
    std::vector<s32> result;
    for (s32 flag : flags) if (LampOfActiveFlag(flag) && !on(flag)) result.push_back(flag);
    return result;
}
// PRODUCTION_LAMPS

void Reset(bool host = false, bool exists = false) {
    for (const auto& entry : std::filesystem::directory_iterator(test_root)) std::filesystem::remove_all(entry.path());
    memory = {{1, {0x80}}}; // Own flag 8 on, host lamp 9 off.
    team_host = host; team_world_taken = false; personal_world_due = false;
    team_world_due = true; team_take.reset(); team_world_blocks.clear(); character_slot = 0;
    kept_lamps_reset = true; relit_lamps.clear();
    team_world = bbcoop::TeamWorld{exists, {{9}, {1}}};
}
bool GuestEnteringANewWorldKeepsOwnProgressBeforeTheHostReports() {
    Reset();
    ApplyTeamWorldOnLoad(false);
    const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(own && own->on == std::vector<s32>{8});
    CHECK(ReadHomeWorlds(0).has_value());
    SetGameFlag(0, 8, false); SetGameFlag(0, 9, true); // What the guest later saved in the visit.
    team_world_due = false; personal_world_due = true;
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool ExistingWorldLampsNeverPolluteTheOwnBackup() {
    Reset(false, true);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(9)); CHECK(!EventFlagOn(8));
    const auto own = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(own && own->on == std::vector<s32>{8});
    return true;
}
bool BecomingANewHostRestoresOwnBlocksBeforeRegisteringHome() {
    Reset(true);
    WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({}));
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8, 16}, {1, 2}}));
    memory[1][0] = 0x40; // Previously visited host's flags in the save.
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9));
    CHECK(ReadHomeWorlds(0)->Has("test"));
    auto remaining = ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)));
    CHECK(remaining && remaining->blocks == std::vector<u32>{2});
    memory[2] = {0}; team_world_blocks.clear();
    ApplyTeamWorldOnLoad(true);
    CHECK(EventFlagOn(16));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool ARepeatLoadKeepsTheOriginalBackup() {
    Reset(false, true);
    ApplyTeamWorldOnLoad(false);
    const auto original = ReadWholeFile(PersonalWorldFile(0));
    ApplyTeamWorldOnLoad(true);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == original);
    return true;
}
bool OwnFlagsFollowTheSlotAndDisappearWithTheBackup() {
    Reset();
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    WriteWholeFile(PersonalWorldFile(1), FormatWorldFlags({{16}, {2}}));
    CHECK(OwnWorldAsideFlagsOn() == std::vector<s32>{8});
    character_slot = 1;
    CHECK(OwnWorldAsideFlagsOn() == std::vector<s32>{16});
    std::filesystem::remove(PersonalWorldFile(1));
    CHECK(OwnWorldAsideFlagsOn().empty());
    return true;
}
bool TitleJoinRelightsOwnAndTeamLampsFromTheirSeparateSources() {
    Reset(false, true);
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    memory[1][0] = 0; // No prior solo tick; the guest started at the title.
    KeepGuestLampsLit();
    CHECK(EventFlagOn(8)); CHECK(EventFlagOn(9));
    CHECK(relit_lamps == (std::set<s32>{8, 9}));
    CHECK(ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)))->on == std::vector<s32>{8});
    return true;
}
bool FailedBackupDefersExistingWorldAndCanRetry() {
    Reset(false, true);
    auto partial = PersonalWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    std::ofstream{partial / "blocker"} << "fixture";
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(!EventFlagOn(8)); CHECK(EventFlagOn(9)); CHECK(team_world_taken);
    CHECK(ParseWorldFlags(ReadWholeFile(PersonalWorldFile(0)))->on == std::vector<s32>{8});
    return true;
}
bool FailedBackupDefersAnUncreatedWorld() {
    Reset();
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}
bool MalformedOrUnreadableBackupNeverBecomesAnEmptyOwnWorld() {
    for (bool directory : {false, true}) {
        Reset(false, true);
        if (directory) std::filesystem::create_directory(PersonalWorldFile(0));
        else std::ofstream{PersonalWorldFile(0)} << "broken-backup";
        ApplyTeamWorldOnLoad(false);
        CHECK(EventFlagOn(8)); CHECK(!EventFlagOn(9)); CHECK(!team_world_taken);
        if (!directory) CHECK(ReadWholeFile(PersonalWorldFile(0)) == "broken-backup");
    }
    return true;
}
bool FailedBackupExtensionPreservesThePreviousCompleteBackup() {
    Reset(false, true);
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    const std::string before = ReadWholeFile(PersonalWorldFile(0));
    memory[2] = {0x80}; team_world->flags = {{9, 17}, {1, 2}};
    auto partial = PersonalWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8)); CHECK(EventFlagOn(16));
    CHECK(!EventFlagOn(9)); CHECK(!EventFlagOn(17)); CHECK(!team_world_taken);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    return true;
}
bool FailedNativeRestoreKeepsBackupAndBlocksHomeRegistration() {
    Reset(true);
    WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds({}));
    WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}}));
    const auto before = ReadWholeFile(PersonalWorldFile(0));
    memory[1][0] = 0x40;
    ignored_flag = 8;
    ApplyTeamWorldOnLoad(false);
    ignored_flag = -1;
    CHECK(!EventFlagOn(8) && personal_world_due && !team_world_taken);
    CHECK(ReadWholeFile(PersonalWorldFile(0)) == before);
    CHECK(ReadHomeWorlds(0)->worlds.empty());
    CHECK(PutOwnWorldBack(0, "fixture retry"));
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}


bool RetireOwnWorldPreservesOldArchivesAndLiveSnapshot() {
    Reset();
    const auto live = PersonalWorldFile(0);
    const auto old = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "live-private-world"; }
    { std::ofstream file{old}; file << "older-private-world"; }
    RetireOwnWorld(0);
    CHECK(!std::filesystem::exists(live));
    CHECK(ReadWholeFile(old) == "older-private-world");
    CHECK(ReadWholeFile(old.string() + ".1") == "live-private-world");
    return true;
}
bool RetireOwnWorldArchiveExhaustionNeverDeletesBackup() {
    Reset();
    const auto live = PersonalWorldFile(0);
    const auto old = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "must-not-be-deleted"; }
    for (int i = 0; i < 64; ++i) {
        const auto name = i == 0 ? old : std::filesystem::path(old.string() + "." + std::to_string(i));
        { std::ofstream file{name}; file << "previous-archive"; }
    }
    RetireOwnWorld(0);
    CHECK(ReadWholeFile(live) == "must-not-be-deleted");
    CHECK(ReadWholeFile(old) == "previous-archive");
    CHECK(ReadWholeFile(old.string() + ".63") == "previous-archive");
    return true;
}

// A legacy host must keep its only personal-world sidecar when the home
// metadata destination is unwritable (simulated by a directory at the path).
// Once the filesystem recovers, the next load must retry the registration.
bool FailedLegacyHomeWriteKeepsPersonalSnapshotAndRetries() {
    Reset(true, true);
    const auto old_name = lobby_name;
    lobby_name = "host";
    const auto live = PersonalWorldFile(0);
    const auto archived = test_root / SlotFileName("personal_world_before_home", 0);
    { std::ofstream file{live}; file << "legacy-private-world"; }
    std::filesystem::create_directory(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(ReadWholeFile(live) == "legacy-private-world");
    CHECK(!std::filesystem::exists(archived));
    CHECK(!team_take.has_value());
    std::filesystem::remove_all(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Has("test"));
    CHECK(!std::filesystem::exists(live));
    CHECK(ReadWholeFile(archived) == "legacy-private-world");
    lobby_name = old_name;
    return true;
}

// A new host must not mark the team's first world taken if home metadata
// could not be committed. Retry after repairing the target path.
bool FailedNewHostHomeWriteDoesNotClaimRegisteredWorld() {
    Reset(true, false);
    std::filesystem::create_directory(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_world_taken);
    std::filesystem::remove_all(HomeWorldFile(0));
    ApplyTeamWorldOnLoad(false);
    CHECK(team_world_taken);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Has("test"));
    return true;
}


// Failure-injected metadata writes must not permit a guest's last solo backup
// to be consumed while the durable home-world marker still says "in team".
bool FailedAloneMarkerWriteKeepsOwnWorldForRetry() {
    Reset(false, false);
    HomeWorlds home;
    CHECK(home.Add("test"));
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    CHECK(WriteWholeFile(PersonalWorldFile(0), FormatWorldFlags({{8}, {1}})));
    memory[1][0] = 0x40; // Team visit took flag 8 away and lit 9.
    personal_world_due = true;
    team_world_due = false;
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(personal_world_due);
    CHECK(!EventFlagOn(8) && EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->alone);
    CHECK(std::filesystem::exists(PersonalWorldFile(0)));
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->alone);
    CHECK(!std::filesystem::exists(PersonalWorldFile(0)));
    return true;
}

// An unsuccessful "back in team" marker write must leave both the in-memory
// take decision and original flag state pending. Re-read original alone=true
// on retry, so SaveLeads vs Home is decided from the right save provenance.
bool FailedRejoinMarkerWriteDefersTeamFlagsAndDecision() {
    Reset(false, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    home.alone = true;
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(!team_take.has_value());
    CHECK(!team_world_taken);
    CHECK(EventFlagOn(8) && !EventFlagOn(9));
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->alone);
    std::filesystem::remove_all(partial);
    ApplyTeamWorldOnLoad(false);
    CHECK(team_take.has_value() && team_world_taken);
    CHECK(ReadHomeWorlds(0) && !ReadHomeWorlds(0)->alone);
    CHECK(!EventFlagOn(8) && EventFlagOn(9));
    return true;
}

// A next-playthrough transition cannot mark its old backup retired when the
// filesystem refuses to remove it. The flag and sidecar remain for retry.
bool FailedNextPlaythroughSidecarRemovalKeepsPendingTransition() {
    Reset(true, false);
    const auto own = PersonalWorldFile(0);
    std::filesystem::create_directory(own);
    { std::ofstream file{own / "cannot-delete"}; file << "keep old state"; }
    next_playthrough_due = true;
    personal_world_due = true;
    ApplyTeamWorldOnLoad(false);
    CHECK(next_playthrough_due && personal_world_due && !team_world_taken);
    CHECK(std::filesystem::exists(own / "cannot-delete"));
    std::filesystem::remove_all(own);
    CHECK(WriteWholeFile(own, FormatWorldFlags({{8}, {1}})));
    ApplyTeamWorldOnLoad(false);
    CHECK(!next_playthrough_due && !personal_world_due);
    CHECK(!std::filesystem::exists(own));
    return true;
}


// The world version must retry after a failed sidecar write rather than
// advancing a cache in memory; two characters with the same world/version
// must each receive the metadata in their *own* slot.
bool HostVersionNoteRetriesAndNeverCrossesCharacterSlots() {
    Reset(true, true);
    HomeWorlds home;
    CHECK(home.Add("test"));
    CHECK(WriteWholeFile(HomeWorldFile(0), FormatHomeWorlds(home)));
    CHECK(WriteWholeFile(HomeWorldFile(1), FormatHomeWorlds(home)));
    NoteHomeWorldVersionIfChanged(0, "test", 11);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 0);
    NoteHomeWorldVersionIfChanged(1, "test", 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    // A version change on the original slot must not be acknowledged when
    // a blocked .part path prevents the atomic replacement.
    auto partial = HomeWorldFile(0); partial += ".part";
    std::filesystem::create_directory(partial);
    NoteHomeWorldVersionIfChanged(0, "test", 12);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 11);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    std::filesystem::remove_all(partial);
    NoteHomeWorldVersionIfChanged(0, "test", 12);
    CHECK(ReadHomeWorlds(0) && ReadHomeWorlds(0)->Version("test") == 12);
    CHECK(ReadHomeWorlds(1) && ReadHomeWorlds(1)->Version("test") == 11);
    return true;
}

int main() {
    test_root = std::filesystem::temp_directory_path() /
        ("ultimate-world-fixture-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
    std::filesystem::create_directories(test_root);
    unsigned failed = 0;
    for (auto test : {GuestEnteringANewWorldKeepsOwnProgressBeforeTheHostReports,
                      ExistingWorldLampsNeverPolluteTheOwnBackup,
                      BecomingANewHostRestoresOwnBlocksBeforeRegisteringHome,
                      ARepeatLoadKeepsTheOriginalBackup,
                      OwnFlagsFollowTheSlotAndDisappearWithTheBackup,
                      TitleJoinRelightsOwnAndTeamLampsFromTheirSeparateSources,
                      FailedBackupDefersExistingWorldAndCanRetry,
                      FailedBackupDefersAnUncreatedWorld,
                      MalformedOrUnreadableBackupNeverBecomesAnEmptyOwnWorld,
                      FailedBackupExtensionPreservesThePreviousCompleteBackup,
                      FailedNativeRestoreKeepsBackupAndBlocksHomeRegistration,
                      RetireOwnWorldPreservesOldArchivesAndLiveSnapshot,
                      RetireOwnWorldArchiveExhaustionNeverDeletesBackup,
                      FailedLegacyHomeWriteKeepsPersonalSnapshotAndRetries,
                      FailedNewHostHomeWriteDoesNotClaimRegisteredWorld,
                      FailedAloneMarkerWriteKeepsOwnWorldForRetry,
                      FailedRejoinMarkerWriteDefersTeamFlagsAndDecision,
                      FailedNextPlaythroughSidecarRemovalKeepsPendingTransition,
                      HostVersionNoteRetriesAndNeverCrossesCharacterSlots}) if (!test()) ++failed;
    std::filesystem::remove_all(test_root);
    std::cout << "World preservation scenarios: " << (19 - failed) << "/19 passed\n";
    return failed ? 1 : 0;
}
